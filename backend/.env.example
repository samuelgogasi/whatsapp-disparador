DATABASE_URL="postgresql://postgres:postgres@localhost:5432/whatsapp_news?schema=public"
REDIS_URL="redis://localhost:6379"
PORT=3333
HOST=127.0.0.1
# Gere o token com npm run setup:admin. Nunca compartilhe com os clientes.
ADMIN_API_TOKEN=
# Em produção, obrigatório: https://seu-dominio.com
# PUBLIC_URL=https://seu-dominio.com
# Número com país e DDD, somente dígitos. Ex.: 5511999999999
# PAYMENT_WHATSAPP=5511999999999
# PIX_KEY=sua-chave-pix
WHATSAPP_AUTH_DIR="./.sessions"
MIN_MESSAGE_DELAY_MS=10000
MAX_MESSAGE_DELAY_MS=10000
GROUP_BATCH_SIZE=30
MIN_BATCH_PAUSE_MS=60000
MAX_BATCH_PAUSE_MS=60000
SEND_TIMEOUT_MS=45000
MAX_ACTIVE_CAMPAIGNS=2

# Transmissões entre contas distintas; uma por conta. Pausas não ocupam worker.
DISPATCH_CONCURRENCY=3
DISPATCH_MEMORY_SOFT_MB=1280
